{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "ca",
      "es",
    ],
  },
  "packages": [
    {
      "kind": "remote",
      "repository": "https://github.com/vospennikov/ClusterMap.git",
      "version": {
        "up-to-next-major-version": "3.0.0",
      },
    }, {
      "kind": "local",
      "path": "ValenciaKit",
    },
  ],
  "files": [
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Bikelencia.app", "id": "116DD99C3E76EF7A46136991", "type": "wrapper.application", "index": false },
        {
          "path": "<PRODUCTS>/BikelenciaCore.framework",
          "id": "3AE4D982504A8E0BBBED8D4D",
          "type": "wrapper.framework",
          "index": false,
          "target-membership": [
            "Bikelencia/frameworks",
            { "build-phase": "Bikelencia/copy/Embed Frameworks", "code-sign-on-copy": true, "header-preservation": "remove-on-copy" },
            "BikelenciaDownloader/frameworks",
          ],
        },
        { "path": "<PRODUCTS>/BikelenciaDownloader.appex", "id": "C82E74CA5C9E537842F763AA", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "Bikelencia/copy/Embed ExtensionKit Extensions", "header-preservation": "remove-on-copy" } ] },
      ],
    }, {
