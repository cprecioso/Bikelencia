  "targets": [
    {
      "name": "Bikelencia",
      "id": "10AD8C31BA40DB65B4A2BA87",
      "product": "Products/Bikelencia.app",
      "product-type": "application",
      "dependencies": [
        "BikelenciaCore",
        "BikelenciaDownloader",
      ],
      "build-phases": [
        "compile-sources",
        "resources",
        {
          "kind": "copy",
          "name": "Embed ExtensionKit Extensions",
          "bundle-base-path": "build-products-directory",
          "relative-path": "$(EXTENSIONS_FOLDER_PATH)",
        },
        "frameworks",
        {
          "kind": "copy",
          "name": "Embed Frameworks",
          "bundle-base-path": "frameworks-directory",
        },
      ],
      "package-product-members": [
        {
          "product-name": "ClusterMap",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "ClusterMapSwiftUI",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_ENTITLEMENTS": "Derived/Entitlements/Bikelencia.entitlements",
        "CODE_SIGN_IDENTITY": "iPhone Developer",
        "ENABLE_PREVIEWS": "YES",
        "INFOPLIST_FILE": "Derived/InfoPlists/Bikelencia-Info.plist",
        "IPHONEOS_DEPLOYMENT_TARGET": "27",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "MARKETING_VERSION": "1.5",
        "OTHER_LDFLAGS": [
          "$(inherited)",
          "-L$(DT_TOOLCHAIN_DIR)/usr/lib/swift/$(PLATFORM_NAME)",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "design.precioso.Bikelencia",
        "PRODUCT_NAME": "Bikelencia",
        "SDKROOT": "iphoneos",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD": "YES",
        "SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "$(inherited) DEBUG",
        "SWIFT_COMPILATION_MODE[config=Debug]": "singlefile",
        "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
        "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
        "SWIFT_OPTIMIZATION_LEVEL[config=Release]": "-O",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    }, {
      "name": "BikelenciaCore",
      "id": "D4FB797517BC61BC0414503D",
      "product": "Products/BikelenciaCore.framework",
      "product-type": "framework",
      "build-phases": [
        "compile-sources",
        "resources",
        "frameworks",
        {
          "kind": "copy",
          "name": "Embed Frameworks",
          "bundle-base-path": "frameworks-directory",
        },
      ],
      "package-product-members": [
        {
          "product-name": "ValenciaKit",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "CODE_SIGN_IDENTITY": "",
        "CURRENT_PROJECT_VERSION": "1",
        "DEFINES_MODULE": "YES",
        "DYLIB_COMPATIBILITY_VERSION": "1",
        "DYLIB_CURRENT_VERSION": "1",
        "DYLIB_INSTALL_NAME_BASE": "@rpath",
        "INFOPLIST_FILE": "Derived/InfoPlists/BikelenciaCore-Info.plist",
        "INSTALL_PATH": "$(LOCAL_LIBRARY_DIR)/Frameworks",
        "IPHONEOS_DEPLOYMENT_TARGET": "27",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
          "@loader_path/Frameworks",
        ],
        "OTHER_LDFLAGS": [
          "$(inherited)",
          "-L$(DT_TOOLCHAIN_DIR)/usr/lib/swift/$(PLATFORM_NAME)",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "design.precioso.Bikelencia.Core",
        "PRODUCT_NAME": "BikelenciaCore",
        "SDKROOT": "iphoneos",
        "SKIP_INSTALL": "YES",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD": "YES",
        "SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "$(inherited) DEBUG",
        "SWIFT_COMPILATION_MODE[config=Debug]": "singlefile",
        "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
        "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
        "SWIFT_OPTIMIZATION_LEVEL[config=Release]": "-O",
        "TARGETED_DEVICE_FAMILY": "1,2",
        "VERSIONING_SYSTEM": "apple-generic",
        "VERSION_INFO_PREFIX": "",
      },
    }, {
      "name": "BikelenciaDownloader",
      "id": "F0FDFBA53C94E8CB86ECFF4D",
      "product": "Products/BikelenciaDownloader.appex",
      "product-type": "extensionkit-extension",
      "dependencies": [
        "BikelenciaCore",
      ],
      "build-phases": [
        "compile-sources",
        "resources",
        "frameworks",
        {
          "kind": "copy",
          "name": "Embed Frameworks",
          "bundle-base-path": "frameworks-directory",
        },
      ],
      "build-settings": {
        "CODE_SIGN_ENTITLEMENTS": "Derived/Entitlements/BikelenciaDownloader.entitlements",
        "CODE_SIGN_IDENTITY": "iPhone Developer",
        "INFOPLIST_FILE": "Derived/InfoPlists/BikelenciaDownloader-Info.plist",
        "IPHONEOS_DEPLOYMENT_TARGET": "27",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
          "@executable_path/../../Frameworks",
        ],
        "MARKETING_VERSION": "1.5",
        "OTHER_LDFLAGS": [
          "$(inherited)",
          "-L$(DT_TOOLCHAIN_DIR)/usr/lib/swift/$(PLATFORM_NAME)",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "design.precioso.Bikelencia.Downloader",
        "PRODUCT_NAME": "BikelenciaDownloader",
        "SDKROOT": "iphoneos",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD": "YES",
        "SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "$(inherited) DEBUG",
        "SWIFT_COMPILATION_MODE[config=Debug]": "singlefile",
        "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
        "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
        "SWIFT_OPTIMIZATION_LEVEL[config=Release]": "-O",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS": "YES",
    "CLANG_ANALYZER_LOCALIZABILITY_NONLOCALIZED": "YES",
