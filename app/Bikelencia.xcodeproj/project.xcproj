                { "path": "AppIcon.icon", "target-membership": [ "Bikelencia/resources" ] },
                { "path": "Assets.xcassets", "target-membership": [ "Bikelencia/resources" ] },
                { "path": "Bikelencia-InfoPlist.xcstrings", "target-membership": [ "Bikelencia/resources" ] },
                { "path": "Localizable.xcstrings", "target-membership": [ "Bikelencia/resources" ] },
              ],
            }, {
